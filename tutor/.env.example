# ─────────────────────────────────────────────────────────────
# انسخ هذا الملف باسم .env.local وضع القيم الحقيقية فيه.
# لا ترفع ملف .env.local أبداً (هو محمي في .gitignore).
# ─────────────────────────────────────────────────────────────

# مفتاح Claude من console.anthropic.com → API Keys.
# إذا تركته فارغاً، يعمل الموقع في "الوضع التجريبي" بردود نموذجية.
ANTHROPIC_API_KEY=

# عدد الرسائل المسموح للزائر (بدون حساب) في اليوم.
GUEST_DAILY_MESSAGE_LIMIT=5

# عنوان الموقع بعد النشر (يُستخدم للحماية من الطلبات القادمة من مواقع أخرى).
# مثال: https://www.sanad.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
