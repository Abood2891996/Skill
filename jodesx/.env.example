# Public site URL used for canonical URLs, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.jodesx.com

# Optional: public business email shown on the contact page and as a fallback
# when form delivery is not configured. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Contact form delivery (server-only; configure ONE option) ----
# Option A: generic webhook (Zapier, Make, n8n, Slack workflow, CRM endpoint…)
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the "X-JoDesx-Signature" HMAC-SHA256 header.
CONTACT_WEBHOOK_SECRET=

# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---- Job applications (optional; fall back to the contact settings above) ----
CAREERS_WEBHOOK_URL=
CAREERS_WEBHOOK_SECRET=
CAREERS_TO_EMAIL=
